<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="{{ settings.color_background | default: '#0B0B0C' }}">

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- style -%}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    
    {%- assign font_heading_bold = settings.font_heading | font_modify: 'weight', 'bold' -%}
    {%- if font_heading_bold -%}
      {{ font_heading_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    
    {%- assign font_body_bold = settings.font_body | font_modify: 'weight', 'bold' -%}
    {%- if font_body_bold -%}
      {{ font_body_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endstyle -%}

  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {% endif %}

  <!-- Title & Meta Description -->
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Biryani Palace by Niamat — Authentic slow-cooked dum biryani prepared fresh and delivered across Kalyan West, Kalyan East, Dombivli, and Ulhasnagar. Order instant delivery or pre-order family feasts.">
  {% endif %}

  <!-- OpenGraph / Social Meta Tags -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="restaurant">
  <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">

  {{ content_for_header }}

  <!-- Theme Core CSS -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign phone = settings.phone_number | default: settings.contact_phone
    assign address = settings.address_line
    assign color_bg = settings.color_background | default: '#0B0B0C'
    assign color_surface = settings.color_surface | default: '#16161A'
    assign color_elevated = settings.color_surface_elevated | default: '#1F1F24'
    assign color_primary = settings.color_primary | default: '#F4B41A'
    assign color_primary_dark = settings.color_primary_dark | default: '#D49010'
    assign color_text = settings.color_text_primary | default: '#FFFFFF'
    assign color_text_sec = settings.color_text_secondary | default: '#AAAAA2'
    assign color_border = settings.color_border | default: 'rgba(244,180,26,0.16)'
    assign color_veg = settings.color_veg | default: '#2ECC71'
    assign color_nonveg = settings.color_nonveg | default: '#E74C3C'
  -%}
  <style id="theme-color-vars">
    :root {
      --color-bg: {{ color_bg }};
      --color-dominant-60: {{ color_bg }};
      --color-surface: {{ color_surface }};
      --color-surface-elevated: {{ color_elevated }};
      --color-secondary-30: {{ color_surface }};
      --color-border: {{ color_border }};
      --color-primary: {{ color_primary }};
      --color-primary-dark: {{ color_primary_dark }};
      --color-accent: {{ color_primary }};
      --color-accent-10: {{ color_primary }};
      --color-accent-dark: {{ color_primary_dark }};
      --color-text-primary: {{ color_text }};
      --color-text-secondary: {{ color_text_sec }};
      --color-veg: {{ color_veg }};
      --color-nonveg: {{ color_nonveg }};
      --logo-width: {{ settings.logo_width | default: 150 }}px;

      /* Dynamic Typography Font Mappings */
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};

      /* Dynamic Visual styling tokens */
      --button-style: {{ settings.button_style | default: 'rounded' }};
      --card-border-style: {{ settings.card_border_style | default: 'rounded' }};
      --shadow-style: {{ settings.shadow_style | default: 'subtle' }};
    }
  </style>

  <!-- Restaurant + Local Business Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": {{ settings.brand_name | default: shop.name | json }},
    "description": "Premium Dum Biryani prepared fresh and delivered across Kalyan. Freshly prepared, 100% Halal.",
    "url": {{ shop.url | json }},
    "telephone": {{ phone | json }},
    "servesCuisine": ["Indian", "Biryani", "Mughlai"],
    "priceRange": "₹₹",
    "currenciesAccepted": "INR",
    "paymentAccepted": "Cash, Credit Card, Debit Card, UPI",
    "hasMenu": "{{ shop.url }}/pages/menu",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ address | json }},
      "addressLocality": "Kalyan",
      "addressRegion": "Maharashtra",
      "postalCode": "421301",
      "addressCountry": "IN"
    }
  }
  </script>

  <!-- Meta Pixel Code -->
  {% if settings.facebook_pixel_id != blank %}
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '{{ settings.facebook_pixel_id }}');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id={{ settings.facebook_pixel_id }}&ev=PageView&noscript=1"/></noscript>
  {% endif %}

  <!-- GA4 Measurement Code -->
  {% if settings.ga4_measurement_id != blank %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.ga4_measurement_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ settings.ga4_measurement_id }}');
  </script>
  {% endif %}
</head>

<body class="template-{{ template.name | handle }} {% if settings.header_sticky %}has-sticky-header{% endif %} btn-style-{{ settings.button_style | default: 'rounded' }} card-style-{{ settings.card_border_style | default: 'rounded' }} shadow-style-{{ settings.shadow_style | default: 'subtle' }}">

  <a class="skip-to-content-link btn btn-primary visually-hidden" href="#MainContent">
    Skip to content
  </a>

  <!-- Dark Backdrop Overlay for Cart & Modals -->
  <div class="cart-overlay" id="CartOverlay" aria-hidden="true"></div>

  <!-- Cart drawer -->
  {% section 'cart-drawer' %}

  <!-- Header -->
  {% section 'header' %}

  <!-- Main Content -->
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  {% section 'footer' %}

  <!-- Floating WhatsApp Button -->
  {% if settings.enable_whatsapp_order %}
    <a
      href="https://wa.me/{{ settings.whatsapp_number }}?text={{ settings.whatsapp_order_msg | url_encode }}"
      class="whatsapp-fab"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Order on WhatsApp"
      id="WhatsAppFabBtn"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      <span>Support</span>
    </a>
  {% endif %}

  <!-- Mobile App Floating Cart Bar (App-like Zomato/Behrouz Cart Bar) -->
  <div class="mobile-floating-cart-bar {% if cart.item_count > 0 %}active{% endif %}" id="MobileFloatingCartBar">
    <div class="m-cart-info">
      <span class="m-cart-count" id="MobileCartCountPill">{{ cart.item_count }} ITEMS</span>
      <span class="m-cart-total" id="MobileCartTotalPill">₹{{ cart.total_price | money_without_currency | remove: '.00' }}</span>
    </div>
    <button class="m-cart-btn" id="MobileCartBarTrigger">
      <span>View Order</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </button>
  </div>

  <!-- Mobile App Bottom Navigation Bar -->
  <nav class="app-bottom-nav" aria-label="Mobile Navigation">
    <a href="/" class="app-nav-item {% if template == 'index' %}active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Home</span>
    </a>
    <a href="/pages/menu" class="app-nav-item {% if page.handle == 'menu' %}active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span>Menu</span>
    </a>
    <a href="/collections/instant-delivery" class="app-nav-item highlight {% if collection.handle == 'instant-delivery' %}active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      <span>Instant</span>
    </a>
    <a href="/pages/family-feast" class="app-nav-item {% if page.handle == 'family-feast' %}active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>Family</span>
    </a>
    <button type="button" class="app-nav-item" id="AppBottomCartBtn">
      <div style="position:relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="app-nav-badge" id="AppNavCartBadge">{{ cart.item_count }}</span>
      </div>
      <span>Cart</span>
    </button>
  </nav>

  <!-- Smart Add-on Modal -->
  <div class="addon-modal" id="AddonModal" role="dialog" aria-modal="true" aria-label="Complete your meal" aria-hidden="true">
    <div class="addon-modal__backdrop" id="AddonModalBackdrop"></div>
    <div class="addon-modal__panel">
      <button class="addon-modal__close" id="AddonModalClose" aria-label="Close">✕</button>
      <div class="addon-modal__header">
        <div class="addon-modal__check">✓</div>
        <h3 class="addon-modal__title">Added to your order</h3>
        <p class="addon-modal__subtitle" id="AddonProductName"></p>
      </div>
      <div class="addon-modal__divider">
        <span>Complete your meal</span>
      </div>
      <div class="addon-modal__items" id="AddonItems">
        <!-- Populated by JS -->
      </div>
      <div class="addon-modal__actions">
        <button class="addon-modal__continue" id="AddonContinue">Continue Ordering</button>
        <a href="/checkout" class="addon-modal__checkout" id="AddonCheckout">
          Proceed to Checkout →
        </a>
      </div>
    </div>
  </div>

  <!-- Toast notifications -->
  <div id="ToastContainer" class="toast-container" role="live" aria-live="polite"></div>

  <!-- Theme JavaScript config -->
  <script>
    window.BiryaniTheme = {
      cartEnabled: {{ settings.enable_ajax_cart | default: true | json }},
      freeItemThreshold: {{ settings.free_item_threshold | default: 0 | json }},
      freeItemName: {{ settings.free_item_name | default: '' | json }},
      deliveryAreas: {{ settings.delivery_areas | default: 'Kalyan West, Kalyan East, Dombivli, Ulhasnagar' | split: ',' | json }},
      deliveryMinOrder: {{ settings.delivery_min_order | default: 0 | json }},
      deliveryFreeAbove: {{ settings.delivery_free_above | default: settings.free_shipping_threshold | default: 799 | json }},
      shopCurrency: {{ cart.currency.symbol | json }},
      cartItemCount: {{ cart.item_count }},
      cartTotal: {{ cart.total_price }},
      kitchenStatus: {{ settings.kitchen_status | default: 'open' | json }},
      kitchenPrepTime: {{ settings.kitchen_prep_time | default: '30–60' | json }},
      kitchenCloseTime: {{ settings.kitchen_close_time | default: '10:30 PM' | json }},
      whatsappNumber: {{ settings.whatsapp_number | json }},
      pixelId: {{ settings.facebook_pixel_id | default: '' | json }},
      ga4Id: {{ settings.ga4_measurement_id | default: '' | json }},
      addonProducts: {{ settings.addon_product_handles | default: '' | json }},
    };
  </script>
   {{ 'theme.js' | asset_url | script_tag }}

</body>
</html>