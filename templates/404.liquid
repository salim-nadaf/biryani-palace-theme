{% comment %} 404 Not Found template {% endcomment %}

<section style="min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:60px 0;" id="NotFoundPage">
  <div>
    <div style="font-size:5rem;margin-bottom:24px;">🍚</div>
    <h1 style="margin-bottom:12px;color:var(--color-primary);">Oops! Page Not Found</h1>
    <p style="max-width:400px;margin:0 auto 32px;">The page you're looking for seems to have vanished like steam from our biryani. Let's get you back on track.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
      <a href="/" class="btn btn-primary btn-lg" id="NotFound404Home">Back to Home</a>
      <a href="/menu" class="btn btn-outline btn-lg" id="NotFound404Menu">Browse Menu</a>
    </div>
  </div>
</section>
