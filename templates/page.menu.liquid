{% comment %}
  Digital Restaurant Menu Page — Browsing All Dishes
  Grouped naturally, clear availability badges, exactly ONE primary button per dish (Order Now for Instant vs Pre-order for Family Feast).
{% endcomment %}

<section class="menu-section" id="RestaurantMenuPage" aria-label="Restaurant Menu">
  <div class="container">

    <!-- Header -->
    <div class="section-header section-header--center" style="margin-bottom:32px;">
      <span class="section-label">Biryani Palace by Niamat</span>
      <h1 class="section-title">Our Restaurant Menu</h1>
      <p class="section-sub">Explore our authentic dum biryanis, starters, and beverages. Select an item to order for instant delivery or reserve for a family feast.</p>
    </div>

    <!-- Search Bar -->
    <div class="menu-search-wrap" style="max-width:480px;margin:0 auto 28px;">
      <svg class="menu-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input
        type="text"
        class="menu-search-input"
        id="RestaurantMenuSearch"
        placeholder="Search biryanis, starters, desserts..."
        aria-label="Search menu items"
      >
    </div>

    <!-- Grouping Filter Tabs -->
    <div class="menu-filter-bar" id="MenuFilterBar" style="justify-content:center;">
      <button class="menu-filter-btn active" data-filter="all">All Dishes</button>
      <button class="menu-filter-btn" data-filter="classic">Classic Biryanis</button>
      <button class="menu-filter-btn" data-filter="premium">Premium Biryanis</button>
      <button class="menu-filter-btn" data-filter="veg">Veg Biryanis</button>
      <button class="menu-filter-btn" data-filter="starters">Starters & Sides</button>
      <button class="menu-filter-btn" data-filter="desserts">Desserts & Drinks</button>
      <button class="menu-filter-btn" data-filter="available">Available Now</button>
      <button class="menu-filter-btn" data-filter="family">Family Feasts</button>
    </div>

    <!-- Menu Grid -->
    <div class="menu-grid" id="RestaurantMenuGrid">
      {% for product in collections.all.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <!-- Demo Restaurant Menu Items -->
        
        <!-- 1. Classic Chicken Biryani (Instant) -->
        <div class="product-card" data-category="classic available">
          <div class="product-card__image-wrap">
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--color-surface-elevated);">🍚</div>
            <div class="product-card__badges"><span class="product-card__tag">Classic</span></div>
            <span class="product-card__veg-indicator non-veg"></span>
          </div>
          <div class="product-card__body">
            <h3 class="product-card__name">Hyderabadi Chicken Dum Biryani</h3>
            <p class="product-card__desc">Marinated chicken slow-cooked on dum with saffron basmati rice and signature spices.</p>
            <div class="product-card__serving-prep">
              <div class="product-card__info-item"><span>Plate / Half Kg</span></div>
              <div class="product-card__info-item"><span>Serves 1–2 &bull; 30–60 min</span></div>
            </div>
            <div class="product-card__avail now">Instant Delivery Available</div>
            <div class="product-card__footer">
              <div class="product-card__price"><span class="currency">₹</span>299</div>
              <a href="/collections/instant-delivery" class="add-to-cart-btn" style="text-decoration:none;">Order Now</a>
            </div>
          </div>
        </div>

        <!-- 2. Premium Mutton Biryani (Instant) -->
        <div class="product-card" data-category="premium available">
          <div class="product-card__image-wrap">
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--color-surface-elevated);">🍖</div>
            <div class="product-card__badges"><span class="product-card__tag">Chef's Special</span></div>
            <span class="product-card__veg-indicator non-veg"></span>
          </div>
          <div class="product-card__body">
            <h3 class="product-card__name">Mutton Shahi Dum Biryani</h3>
            <p class="product-card__desc">Tender mutton pieces layered with long-grain basmati rice, caramelized onions, and pure desi ghee.</p>
            <div class="product-card__serving-prep">
              <div class="product-card__info-item"><span>Double Plate / Half Kg</span></div>
              <div class="product-card__info-item"><span>Serves 2 &bull; 30–60 min</span></div>
            </div>
            <div class="product-card__avail now">Instant Delivery Available</div>
            <div class="product-card__footer">
              <div class="product-card__price"><span class="currency">₹</span>399</div>
              <a href="/collections/instant-delivery" class="add-to-cart-btn" style="text-decoration:none;">Order Now</a>
            </div>
          </div>
        </div>

        <!-- 3. Veg Biryani (Instant) -->
        <div class="product-card" data-category="veg available">
          <div class="product-card__image-wrap">
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--color-surface-elevated);">🌱</div>
            <div class="product-card__badges"><span class="product-card__tag" style="background:var(--color-veg);color:#fff;">Veg Special</span></div>
            <span class="product-card__veg-indicator veg"></span>
          </div>
          <div class="product-card__body">
            <h3 class="product-card__name">Paneer Royal Dum Biryani</h3>
            <p class="product-card__desc">Fresh cottage cheese cubes marinated in aromatic spices and slow-cooked with basmati rice.</p>
            <div class="product-card__serving-prep">
              <div class="product-card__info-item"><span>Single Plate / Half Kg</span></div>
              <div class="product-card__info-item"><span>Serves 1–2 &bull; 30–60 min</span></div>
            </div>
            <div class="product-card__avail now">Instant Delivery Available</div>
            <div class="product-card__footer">
              <div class="product-card__price"><span class="currency">₹</span>259</div>
              <a href="/collections/instant-delivery" class="add-to-cart-btn" style="text-decoration:none;">Order Now</a>
            </div>
          </div>
        </div>

        <!-- 4. Family Feast 2 KG (Pre-order) -->
        <div class="product-card" data-category="family premium">
          <div class="product-card__image-wrap">
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--color-surface-elevated);">👑</div>
            <div class="product-card__badges"><span class="product-card__tag">Family Pack</span></div>
            <span class="product-card__veg-indicator non-veg"></span>
          </div>
          <div class="product-card__body">
            <h3 class="product-card__name">2 KG Shahi Family Feast</h3>
            <p class="product-card__desc">2 KG Dum Biryani + Gravy + Starter + Dessert. Complete meal for family gatherings.</p>
            <div class="product-card__serving-prep">
              <div class="product-card__info-item"><span>2 KG / 3 KG Available</span></div>
              <div class="product-card__info-item"><span>Serves 8–10 &bull; Advance Booking</span></div>
            </div>
            <div class="product-card__avail preorder">Pre-order Required</div>
            <div class="product-card__footer">
              <div class="product-card__price"><span class="currency">₹</span>1,699</div>
              <a href="/pages/family-feast" class="reserve-btn" style="text-decoration:none;">Pre-order →</a>
            </div>
          </div>
        </div>

      {% endfor %}
    </div>

  </div>
</section>
