{% comment %}
  About Page Template
{% endcomment %}

<section style="padding: 72px 0;" id="AboutPage" aria-label="About Us">
  <div class="container">
    
    <!-- Page Header -->
    <div style="margin-bottom: 36px; text-align: center;" class="animate-on-scroll">
      <span class="section-label">Our Journey</span>
      <h1 style="margin-bottom: 16px; font-family: 'Alata', sans-serif;">{{ page.title | default: 'Our Story — Biryani Palace by Niamat' }}</h1>
      <p style="max-width: 600px; margin: 0 auto; color: var(--color-text-secondary);">Crafting authentic dum biryani with handpicked spices, 6-hour marination, and traditional slow cooking.</p>
    </div>

    <!-- Page Content (if edited in Shopify Admin) -->
    {% if page.content != blank %}
      <div class="page-content animate-on-scroll" style="color: var(--color-text-secondary); line-height: 1.8; font-family: 'Montserrat', sans-serif; font-size: 0.9375rem; max-width: 800px; margin: 0 auto 48px;">
        {{ page.content }}
      </div>
    {% endif %}

    <!-- About Brand Section -->
    {% section 'about-brand' %}

  </div>
</section>
