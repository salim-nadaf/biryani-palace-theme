{% comment %}
  Default Page Template (REQUIRED by Shopify for rendering any page)
  Renders pages like About Us, Our Story, Privacy Policy, Terms, etc.
{% endcomment %}

<section style="padding: 72px 0; min-height: 70vh;" id="DefaultPageTemplate" aria-label="{{ page.title }}">
  <div class="container" style="max-width: 800px;">
    
    <!-- Page Header -->
    <div style="margin-bottom: 36px;" class="animate-on-scroll">
      <span class="section-label">Biryani Palace by Niamat</span>
      <h1 style="margin-bottom: 16px; font-family: 'Alata', sans-serif; color: var(--color-text-primary);">{{ page.title }}</h1>
      <div style="width: 48px; height: 2px; background: var(--color-primary);"></div>
    </div>

    <!-- Page Content (from Shopify Admin Page Editor) -->
    <div class="page-content animate-on-scroll" style="color: var(--color-text-secondary); line-height: 1.8; font-family: 'Montserrat', sans-serif; font-size: 0.9375rem;">
      {{ page.content }}
    </div>

  </div>
</section>
