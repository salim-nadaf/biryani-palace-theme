{% comment %} Product page template {% endcomment %}

<section class="product-page" id="ProductPage" style="padding: 60px 0;" aria-label="{{ product.title }}">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">

      <!-- Product Image -->
      <div style="border-radius:20px;overflow:hidden;border:1px solid var(--color-border);">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="800"
            height="600"
            loading="eager"
            style="width:100%;display:block;object-fit:cover;"
          >
        {% else %}
          <div style="aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:5rem;background:var(--color-surface-elevated);">🍚</div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div>
        <h1 style="margin-bottom:12px;">{{ product.title }}</h1>

        <div style="font-size:1.75rem;font-weight:700;color:var(--color-primary);margin-bottom:16px;">
          ₹{{ product.price | money_without_currency | remove: '.00' }}
          {% if product.compare_at_price > product.price %}
            <del style="font-size:1rem;color:var(--color-text-secondary);font-weight:400;margin-left:8px;">₹{{ product.compare_at_price | money_without_currency | remove: '.00' }}</del>
          {% endif %}
        </div>

        {% if product.description != blank %}
          <div style="color:var(--color-text-secondary);line-height:1.8;margin-bottom:28px;">{{ product.description }}</div>
        {% endif %}

        <!-- Variant Selector -->
        {% if product.variants.size > 1 %}
          <div style="margin-bottom:20px;">
            <label for="ProductVariant" style="font-size:0.875rem;font-weight:600;margin-bottom:8px;display:block;color:var(--color-text-secondary);">Choose Option</label>
            <select id="ProductVariant" style="width:100%;padding:12px 16px;background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text-primary);font-size:0.9375rem;font-family:var(--font-body);">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} (Unavailable){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" id="ProductVariant" value="{{ product.first_available_variant.id }}">
        {% endif %}

        <!-- Add to Cart -->
        {% if product.available %}
          <button
            class="add-to-cart-btn"
            data-variant="{{ product.first_available_variant.id }}"
            data-label="Add to Order"
            id="ProductAddToCart"
            style="width:100%;padding:16px;font-size:1rem;"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Add to Order
          </button>
        {% else %}
          <button disabled class="btn btn-ghost" style="width:100%;opacity:0.5;cursor:not-allowed;">Currently Unavailable</button>
        {% endif %}

        <!-- Product Tags -->
        {% if product.tags.size > 0 %}
          <div style="margin-top:24px;display:flex;flex-wrap:wrap;gap:8px;">
            {% for tag in product.tags %}
              <span style="padding:4px 12px;background:rgba(244,180,26,0.1);border:1px solid rgba(244,180,26,0.3);font-size:0.75rem;color:var(--color-primary);">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}

        <!-- Back to menu -->
        <a href="/menu" style="display:inline-flex;align-items:center;gap:8px;margin-top:24px;font-size:0.875rem;color:var(--color-text-secondary);" id="BackToMenuLink">
          ← Back to Menu
        </a>
      </div>
    </div>
  </div>
</section>
