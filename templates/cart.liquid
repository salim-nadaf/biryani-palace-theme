{% comment %} Cart page (fallback for when drawer is disabled) {% endcomment %}

<section style="padding:60px 0;" id="CartPage">
  <div class="container" style="max-width:800px;">
    <h1 style="margin-bottom:32px;">Your Order</h1>

    {% if cart.item_count == 0 %}
      <div style="text-align:center;padding:60px 0;">
        <div style="font-size:4rem;margin-bottom:16px;">🍚</div>
        <h2 style="margin-bottom:12px;font-weight:400;">Your cart is empty</h2>
        <a href="/menu" class="btn btn-primary btn-lg" style="margin-top:16px;" id="EmptyCartMenu">Browse Our Menu</a>
      </div>
    {% else %}
      <form action="/cart" method="post">
        <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;overflow:hidden;margin-bottom:24px;">
          {% for item in cart.items %}
            <div style="display:flex;align-items:center;gap:16px;padding:20px;border-bottom:1px solid var(--color-border);" id="CartPageItem-{{ item.key }}">
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="72" height="72" style="border-radius:10px;object-fit:cover;">
              <div style="flex:1;">
                <div style="font-size:1rem;font-weight:600;margin-bottom:4px;">{{ item.product.title }}</div>
                <div style="color:var(--color-primary);font-weight:600;">₹{{ item.line_price | money_without_currency | remove: '.00' }}</div>
              </div>
              <div class="qty-control">
                <a href="/cart/change?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}" class="qty-btn" aria-label="Decrease quantity">−</a>
                <span class="qty-display">{{ item.quantity }}</span>
                <a href="/cart/change?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}" class="qty-btn" aria-label="Increase quantity">+</a>
              </div>
              <a href="/cart/change?id={{ item.key }}&quantity=0" style="font-size:0.75rem;color:var(--color-text-secondary);text-decoration:underline;" aria-label="Remove {{ item.product.title }}">Remove</a>
            </div>
          {% endfor %}
        </div>

        <!-- Totals -->
        <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:24px;">
          <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
            <span style="color:var(--color-text-secondary);">Subtotal</span>
            <span style="font-size:1.25rem;font-weight:700;">₹{{ cart.total_price | money_without_currency | remove: '.00' }}</span>
          </div>
          <p style="font-size:0.8125rem;color:var(--color-text-secondary);margin-bottom:20px;">Taxes and delivery calculated at checkout</p>
          <a href="/checkout" class="checkout-btn" id="CartPageCheckout">
            Proceed to Checkout →
          </a>
        </div>
      </form>
    {% endif %}
  </div>
</section>
