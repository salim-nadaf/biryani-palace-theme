{% comment %} Collection template - shows all products in a collection {% endcomment %}

{% paginate collection.products by 24 %}
<section style="padding:60px 0;" id="CollectionPage">
  <div class="container">
    <h1 style="margin-bottom:8px;">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p style="margin-bottom:40px;max-width:600px;">{{ collection.description }}</p>
    {% endif %}

    <div class="menu-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="color:var(--color-text-secondary);">No products found in this collection.</p>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div style="display:flex;justify-content:center;gap:8px;margin-top:48px;">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  </div>
</section>
{% endpaginate %}
