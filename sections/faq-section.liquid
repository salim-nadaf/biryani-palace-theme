<section class="faq-section animate-on-scroll" id="FaqSection" aria-label="Frequently Asked Questions">
  <div class="container">

    <div class="section-header section-header--center">
      <span class="section-label">{{ section.settings.label | default: 'Got Questions?' }}</span>
      <h2 class="section-title">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
      <p class="section-sub">{{ section.settings.subheading | default: 'Everything you need to know about our preparation, delivery, payments, and family orders.' }}</p>
    </div>

    <div class="faq-grid" id="FaqAccordionContainer">

      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-{{ block.id }}" id="faq-btn-{{ block.id }}">
              <h4>{{ block.settings.question }}</h4>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer" id="faq-ans-{{ block.id }}" role="region" aria-labelledby="faq-btn-{{ block.id }}">
              <p style="padding-top:12px;">{{ block.settings.answer }}</p>
            </div>
          </div>
        {% endif %}
      {% else %}
        <!-- Default FAQs -->
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d1" id="faq-btn-d1">
            <h4>Where do you deliver?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d1">
            <p style="padding-top:12px;">We deliver up to a maximum radius of 8 KM covering Kalyan West, Kalyan East, Dombivli, and Ulhasnagar. Orders beyond 8 KM are not accepted.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d2" id="faq-btn-d2">
            <h4>What are your delivery charges & free delivery limits?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d2">
            <p style="padding-top:12px;">
              &bull; <strong>0 to 5 KM:</strong> Delivery charge ₹39 (FREE on orders ₹799+)<br>
              &bull; <strong>5 to 8 KM:</strong> Delivery charge ₹89 (FREE on orders ₹1,299+)<br>
              &bull; <strong>Beyond 8 KM:</strong> No delivery / orders accepted.
            </p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d3" id="faq-btn-d3">
            <h4>How long does preparation and delivery take?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d3">
            <p style="padding-top:12px;">Instant delivery items are prepared fresh and delivered within 30–60 minutes. Family & group pre-orders require advance booking.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d4" id="faq-btn-d4">
            <h4>Is your food 100% Halal?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d4">
            <p style="padding-top:12px;">Yes, absolutely. All meat is sourced exclusively from certified 100% Halal suppliers and cooked with utmost hygiene.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d5" id="faq-btn-d5">
            <h4>What payment methods do you accept?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d5">
            <p style="padding-top:12px;">We accept Google Pay, PhonePe, Paytm, All UPI apps, Credit Cards, Debit Cards, Net Banking, and Razorpay Secure.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-ans-d6" id="faq-btn-d6">
            <h4>How do family pre-orders work?</h4>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-ans-d6">
            <p style="padding-top:12px;">Submit your request on our Family Feast page. No payment is collected upfront. Our team reviews your request and sends confirmation & payment details via WhatsApp.</p>
          </div>
        </div>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our preparation, delivery, payments, and family orders."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where do you deliver?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We deliver up to 8 KM max covering Kalyan West, Kalyan East, Dombivli, and Ulhasnagar."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
