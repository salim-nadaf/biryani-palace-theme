<footer class="site-footer" role="contentinfo">
  <div class="container">

    <div class="footer__grid">

      <!-- Brand Column (Centered) -->
      <div class="footer__brand" style="display:flex;flex-direction:column;align-items:center;text-align:center;width:100%;">
        {% assign footer_logo = section.settings.logo | default: settings.logo %}
        {% assign logo_h = section.settings.logo_max_height | default: settings.logo_max_height | default: 75 %}
        {% assign logo_w = section.settings.logo_width | default: settings.logo_width | default: 150 %}

        {% if footer_logo %}
          <img
            src="{{ footer_logo | image_url: width: 600 }}"
            alt="{{ shop.name }}"
            class="footer__logo-img"
            style="max-height: {{ logo_h }}px; max-width: {{ logo_w }}px; width: auto; height: auto; object-fit: contain; display: block; margin: 0 auto 12px;"
            loading="lazy"
          >
        {% else %}
          <div class="footer__brand-name" style="text-align:center;width:100%;">{{ settings.brand_name | default: shop.name }}</div>
        {% endif %}

        <!-- Tagline: Share the Joy (Italicized specifically for footer) -->
        <p class="footer__tagline" style="text-align:center;color:var(--color-primary);font-size:1.0625rem;font-weight:600;font-style:italic;letter-spacing:0.5px;margin-top:4px;margin-bottom:16px;">
          Share the Joy
        </p>

        {% assign display_phone = settings.phone_number | default: settings.contact_phone %}
        {% if settings.address_line != blank %}
        <p style="font-size:0.8125rem;color:var(--color-text-secondary);margin-bottom:16px;line-height:1.6;text-align:center;">
          📍 {{ settings.address_line }}
        </p>
        {% endif %}

        {% if display_phone != blank %}
        <p style="font-size:0.875rem;margin-bottom:16px;text-align:center;">
          <a href="tel:{{ display_phone | remove: ' ' }}" style="color:var(--color-primary);">📞 {{ display_phone }}</a>
        </p>
        {% endif %}

        <!-- Social Icons (Instagram & Facebook only, WhatsApp icon removed) -->
        <div class="footer__social" style="justify-content:center;">
          {% if settings.social_instagram != blank %}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          {% endif %}
          {% if settings.social_facebook != blank %}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          {% endif %}
        </div>
      </div>

      <!-- Links Columns -->
      {% for block in section.blocks %}
        {% if block.type == 'link_column' %}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {% if linklists[block.settings.menu].links.size > 0 %}
          <ul class="footer__links">
            {% for link in linklists[block.settings.menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endif %}
      {% endfor %}

      <!-- Contact Info Column -->
      {% if section.settings.show_contact %}
      <div class="footer__col">
        <h4>{{ section.settings.contact_heading | default: 'Get in Touch' }}</h4>
        <ul class="footer__links">
          <li><a href="tel:{{ settings.contact_phone | remove: ' ' }}">📞 {{ settings.contact_phone | default: '+91 98765 43210' }}</a></li>
          <li><span>📍 Kalyan West, Maharashtra</span></li>
          <li><span>⏰ 12:00 PM – 10:30 PM (Daily)</span></li>
        </ul>
      </div>
      {% endif %}

    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}. All rights reserved.
      </div>
      {% if section.settings.show_powered_by %}
      <div class="footer__powered">
        {{ powered_by_link }}
      </div>
      {% endif %}
      <div class="footer__payments" style="display:flex;gap:8px;align-items:center;font-size:0.75rem;color:var(--color-text-secondary);">
        <span>🔒 100% Halal Certified &bull; UPI &bull; Cards &bull; Cash on Delivery</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Footer Logo"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo Max Height (px)",
      "min": 40,
      "max": 140,
      "step": 5,
      "default": 75
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Max Width (px)",
      "min": 60,
      "max": 300,
      "step": 5,
      "default": 150
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show Contact Column",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Column Heading",
      "default": "Get in Touch"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered By Text",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": { "heading": "Navigation", "menu": "main-menu" }
        },
        {
          "type": "link_column",
          "settings": { "heading": "Legal & Policies", "menu": "footer" }
        }
      ]
    }
  ]
}
{% endschema %}
