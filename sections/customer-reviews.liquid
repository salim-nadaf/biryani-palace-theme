<section class="reviews-section animate-on-scroll" id="CustomerReviewsSection" aria-label="Customer Reviews">
  <div class="container">

    <div class="section-header">
      <span class="section-label">{{ section.settings.label | default: 'Real Reviews' }}</span>
      <h2 class="section-title">{{ section.settings.heading | default: 'Loved by Biryani Enthusiasts' }}</h2>
      <p class="section-sub">{{ section.settings.subheading | default: 'Here is what local food lovers and families in Kalyan say about our biryani.' }}</p>
    </div>

    <!-- Overall Rating Summary -->
    <div class="reviews-summary">
      <div class="reviews-rating-big">{{ section.settings.overall_rating | default: '4.8' }}</div>
      <div>
        <div class="reviews-stars-big">★★★★★</div>
        <div class="reviews-count">Based on {{ section.settings.total_reviews_count | default: '120+' }} Google Reviews</div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="reviews-grid">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="review-card" {{ block.shopify_attributes }}>
            <div class="review-card__source">Google Review</div>
            <div class="review-card__stars">
              {% assign rating_num = block.settings.rating | plus: 0 %}
              {% for i in (1..5) %}
                {% if i <= rating_num %}★{% else %}☆{% endif %}
              {% endfor %}
            </div>
            <p class="review-card__text">{{ block.settings.text }}</p>
            <div class="review-card__author">
              <div class="review-card__avatar">
                {{ block.settings.author | slice: 0 | upcase }}
              </div>
              <div>
                <div class="review-card__name">{{ block.settings.author }}</div>
                <div class="review-card__date">{{ block.settings.date | default: 'Verified Customer' }} &bull; {{ block.settings.location | default: 'Kalyan' }}</div>
              </div>
            </div>
          </div>
        {% endif %}
      {% else %}
        <!-- Default sample reviews -->
        <div class="review-card">
          <div class="review-card__source">Google Review</div>
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">Ordered the 2 KG Chicken Dum Biryani for a family dinner. The rice was so fragrant, chicken super tender, and spice level was perfect for everyone!</p>
          <div class="review-card__author">
            <div class="review-card__avatar">R</div>
            <div>
              <div class="review-card__name">Rohan Sharma</div>
              <div class="review-card__date">Verified Customer &bull; Kalyan West</div>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-card__source">Google Review</div>
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">Best biryani delivery in Kalyan. Hot, fresh, and delivered right on time in 40 mins. Packaging kept the dum aroma intact.</p>
          <div class="review-card__author">
            <div class="review-card__avatar">S</div>
            <div>
              <div class="review-card__name">Sameer Khan</div>
              <div class="review-card__date">Verified Customer &bull; Dombivli</div>
            </div>
          </div>
        </div>

        <div class="review-card">
          <div class="review-card__source">Google Review</div>
          <div class="review-card__stars">★★★★★</div>
          <p class="review-card__text">We ordered 5 KG biryani for an office lunch party. Every single colleague asked where we ordered from. Truly royal taste!</p>
          <div class="review-card__author">
            <div class="review-card__avatar">P</div>
            <div>
              <div class="review-card__name">Pooja Verma</div>
              <div class="review-card__date">Verified Customer &bull; Kalyan East</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Real Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Biryani Enthusiasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Here is what local food lovers and families in Kalyan say about our biryani."
    },
    {
      "type": "text",
      "id": "overall_rating",
      "label": "Overall Rating (e.g. 4.8)",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "total_reviews_count",
      "label": "Total Reviews Text",
      "default": "120+ Verified Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Google Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Kalyan"
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Star Rating",
          "options": [
            { "value": "5", "label": "5 Stars" },
            { "value": "4", "label": "4 Stars" }
          ],
          "default": "5"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "The biryani was delicious, fresh, and delivered hot on time!"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date / Verified tag",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
