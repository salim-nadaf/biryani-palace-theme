<section class="delivery-info-section animate-on-scroll" id="DeliveryInfoSection" aria-label="Delivery Information">
  <div class="container">

    <div class="section-header section-header--center">
      <span class="section-label">{{ section.settings.label | default: 'Delivery Details' }}</span>
      <h2 class="section-title">{{ section.settings.heading | default: 'Delivery Rates & Coverage (Up to 8 KM)' }}</h2>
      <p class="section-sub">{{ section.settings.subheading | default: 'Freshly prepared dum biryani delivered hot. Maximum delivery radius up to 8 KM.' }}</p>
    </div>

    <div class="delivery-info-grid">

      <!-- Coverage -->
      <div class="delivery-info-card">
        <span class="delivery-info-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        </span>
        <div class="delivery-info-card__label">Delivery Coverage</div>
        <div class="delivery-info-card__value">
          Kalyan West &bull; Kalyan East &bull; Dombivli &bull; Ulhasnagar
        </div>
        <div class="delivery-info-card__sub">Up to 8 KM Max Radius</div>
      </div>

      <!-- Zone A: 0 to 5 KM -->
      <div class="delivery-info-card">
        <span class="delivery-info-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </span>
        <div class="delivery-info-card__label">0 to 5 KM Zone</div>
        <div class="delivery-info-card__value">
          Delivery Charge: ₹39<br>
          <strong style="color:var(--color-primary);">FREE Delivery on ₹799+</strong>
        </div>
      </div>

      <!-- Zone B: 5 to 8 KM -->
      <div class="delivery-info-card">
        <span class="delivery-info-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </span>
        <div class="delivery-info-card__label">5 to 8 KM Zone</div>
        <div class="delivery-info-card__value">
          Delivery Charge: ₹89<br>
          <strong style="color:var(--color-primary);">FREE Delivery on ₹1,299+</strong>
        </div>
      </div>

      <!-- Hours & Radius Limit -->
      <div class="delivery-info-card">
        <span class="delivery-info-card__icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        <div class="delivery-info-card__label">Kitchen Hours & Limits</div>
        <div class="delivery-info-card__value">
          Lunch: 12:00 PM – 4:00 PM<br>
          Dinner: 7:00 PM – 10:30 PM
        </div>
        <div class="delivery-info-card__sub" style="color:var(--color-nonveg);font-weight:600;margin-top:6px;">🚫 No orders accepted beyond 8 KM</div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Delivery Info",
  "tag": "section",
  "class": "section-delivery-info",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Delivery Details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery Rates & Coverage (Up to 8 KM)"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Freshly prepared dum biryani delivered hot. Maximum delivery radius up to 8 KM."
    }
  ],
  "presets": [
    {
      "name": "Delivery Info"
    }
  ]
}
{% endschema %}
