<section class="hero" id="HeroBanner" aria-label="{{ section.settings.heading }}">
  <!-- Background Image / Video -->
  <div class="hero__bg">
    {% if section.settings.bg_video_url != blank %}
      <video autoplay loop muted playsinline poster="{{ section.settings.hero_image | image_url: width: 1920 }}">
        <source src="{{ section.settings.bg_video_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.hero_image %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1920 }}"
        srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1400 }} 1400w, {{ section.settings.hero_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}"
        width="1920"
        height="1080"
        loading="eager"
      >
    {% endif %}
  </div>

  <div class="hero__overlay"></div>

  <div class="container" style="position:relative;z-index:2;">
    <div class="hero__content">

      <!-- Eyebrow -->
      {% if section.settings.eyebrow != blank %}
        <div class="hero__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      <!-- Kitchen Status Badge -->
      <div class="hero__kitchen-status">
        <div class="kitchen-status-badge {{ settings.kitchen_status | default: 'open' }}" id="HeroKitchenBadge">
          <span class="kitchen-status-dot"></span>
          {% if settings.kitchen_status == 'closed' %}
            Kitchen Closed &bull; Pre-orders Available
          {% elsif settings.kitchen_status == 'limited' %}
            Limited Stock &bull; Ready in {{ settings.kitchen_prep_time | default: '30–60' }} min
          {% else %}
            Accepting Orders &bull; Ready in {{ settings.kitchen_prep_time | default: '30–60' }} min
          {% endif %}
        </div>
      </div>

      <!-- Headline -->
      <h1 class="hero__title">
        {{ section.settings.heading | default: 'Freshly Prepared Premium Dum Biryani' }}
      </h1>

      <!-- Subtitle -->
      <p class="hero__subtitle">
        {{ section.settings.subheading | default: 'Slow-cooked on dum with authentic spices. Prepared fresh for families and gatherings in Kalyan.' }}
      </p>

      <!-- Action Buttons -->
      <div class="hero__actions">
        <a
          href="{{ section.settings.primary_cta_url | default: '/pages/start-your-order' }}"
          class="btn btn-primary btn-lg"
          id="HeroPrimaryCta"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          {{ section.settings.primary_cta_text | default: 'Order Now' }}
        </a>

        <a
          href="{{ section.settings.secondary_cta_url | default: '/pages/family-feast' }}"
          class="btn btn-outline btn-lg"
          id="HeroSecondaryCta"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          {{ section.settings.secondary_cta_text | default: 'Family Orders' }}
        </a>
      </div>

      <!-- Meta Trust Info -->
      <div class="hero__meta">
        <div class="hero__meta-item">
          <strong>30–60 Min</strong>
          <span>Delivery Time</span>
        </div>
        <div class="hero__meta-item">
          <strong>100% Halal</strong>
          <span>Fresh Ingredients</span>
        </div>
        <div class="hero__meta-item">
          <strong>Kalyan & Nearby</strong>
          <span>Delivery Range</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "url",
      "id": "bg_video_url",
      "label": "Background Video MP4 URL (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "👑 PREMIUM CLOUD KITCHEN — KALYAN & BEYOND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Freshly Prepared Premium Dum Biryani"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Slow-cooked on dum with authentic spices. Prepared fresh for families and gatherings in Kalyan."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "Family Orders"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
