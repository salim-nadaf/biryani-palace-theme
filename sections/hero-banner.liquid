{% comment %}
  Hero Banner Section — Dawn-Style Modular Block Architecture
{% endcomment %}

<section
  class="hero"
  id="HeroBanner"
  aria-label="Hero Banner"
  style="
    min-height: {{ section.settings.desktop_height | default: 750 }}px;
    text-align: {{ section.settings.text_alignment | default: 'left' }};
  "
>
  <!-- Background Image / Video -->
  <div class="hero__bg">
    {% if section.settings.bg_video_url != blank %}
      <video autoplay loop muted playsinline poster="{{ section.settings.hero_image | image_url: width: 1920 }}">
        <source src="{{ section.settings.bg_video_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.hero_image %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1920 }}"
        srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1400 }} 1400w, {{ section.settings.hero_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.hero_image.alt | default: 'Biryani Palace' | escape }}"
        width="1920"
        height="1080"
        loading="eager"
      >
    {% endif %}
  </div>

  <!-- Custom Overlay Opacity -->
  {% assign opacity_val = section.settings.overlay_opacity | default: 80 | divided_by: 100.0 %}
  <div class="hero__overlay" style="background: linear-gradient(180deg, rgba(14,14,14,{{ opacity_val | times: 0.7 }}) 0%, rgba(14,14,14,{{ opacity_val }}) 100%);"></div>

  <div class="container" style="position:relative;z-index:2;">
    <div class="hero__content" style="{% if section.settings.text_alignment == 'center' %}margin:0 auto;{% endif %}">

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'eyebrow' %}
            <div class="hero__eyebrow" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {% when 'kitchen_status' %}
            <div class="hero__kitchen-status" {{ block.shopify_attributes }}>
              <div class="kitchen-status-badge {{ settings.kitchen_status | default: 'open' }}" id="HeroKitchenBadge">
                <span class="kitchen-status-dot"></span>
                {% if settings.kitchen_status == 'closed' %}
                  Kitchen Closed &bull; Pre-orders Available
                {% elsif settings.kitchen_status == 'limited' %}
                  Limited Stock &bull; Ready in {{ settings.kitchen_prep_time | default: '30–60' }} min
                {% else %}
                  Accepting Orders &bull; Ready in {{ settings.kitchen_prep_time | default: '30–60' }} min
                {% endif %}
              </div>
            </div>

          {% when 'heading' %}
            <h1 class="hero__title" style="color: {{ block.settings.heading_color | default: 'var(--color-text-primary)' }};" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h1>

          {% when 'subheading' %}
            <p class="hero__subtitle" style="color: {{ block.settings.subheading_color | default: 'var(--color-text-secondary)' }};" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {% when 'buttons' %}
            <div class="hero__actions" style="{% if section.settings.text_alignment == 'center' %}justify-content:center;{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.primary_cta_text != blank %}
                <a
                  href="{{ block.settings.primary_cta_url | default: '/collections/instant-delivery' }}"
                  class="btn btn-primary btn-lg"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  {{ block.settings.primary_cta_text }}
                </a>
              {% endif %}

              {% if block.settings.secondary_cta_text != blank %}
                <a
                  href="{{ block.settings.secondary_cta_url | default: '/pages/family-feast' }}"
                  class="btn btn-outline btn-lg"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                  {{ block.settings.secondary_cta_text }}
                </a>
              {% endif %}
            </div>

          {% when 'trust_badges' %}
            <div class="hero__meta" style="{% if section.settings.text_alignment == 'center' %}justify-content:center;{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.badge1_title != blank %}
                <div class="hero__meta-item">
                  <strong>{{ block.settings.badge1_title }}</strong>
                  <span>{{ block.settings.badge1_sub }}</span>
                </div>
              {% endif %}
              {% if block.settings.badge2_title != blank %}
                <div class="hero__meta-item">
                  <strong>{{ block.settings.badge2_title }}</strong>
                  <span>{{ block.settings.badge2_sub }}</span>
                </div>
              {% endif %}
              {% if block.settings.badge3_title != blank %}
                <div class="hero__meta-item">
                  <strong>{{ block.settings.badge3_title }}</strong>
                  <span>{{ block.settings.badge3_sub }}</span>
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "url",
      "id": "bg_video_url",
      "label": "Background Video MP4 URL (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hero Height (px)",
      "min": 300,
      "max": 800,
      "step": 25,
      "default": 480
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow Tag",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tag Text",
          "default": "👑 PREMIUM CLOUD KITCHEN — KALYAN & BEYOND"
        }
      ]
    },
    {
      "type": "kitchen_status",
      "name": "Kitchen Status Badge",
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Main Heading",
          "default": "Freshly Prepared Premium Dum Biryani"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Text Color",
          "default": "#FFFFFF"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Description Text",
          "default": "Slow-cooked on dum with authentic spices. Prepared fresh for families and gatherings in Kalyan."
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Description Color",
          "default": "#AAAAAA"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Call to Action Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "primary_cta_text",
          "label": "Primary Button Text",
          "default": "Order Instant Delivery"
        },
        {
          "type": "url",
          "id": "primary_cta_url",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_cta_text",
          "label": "Secondary Button Text",
          "default": "Pre-order Family Feast"
        },
        {
          "type": "url",
          "id": "secondary_cta_url",
          "label": "Secondary Button Link"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges Strip",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "badge1_title",
          "label": "Badge 1 Title",
          "default": "30–60 Min"
        },
        {
          "type": "text",
          "id": "badge1_sub",
          "label": "Badge 1 Label",
          "default": "Delivery Time"
        },
        {
          "type": "text",
          "id": "badge2_title",
          "label": "Badge 2 Title",
          "default": "100% Halal"
        },
        {
          "type": "text",
          "id": "badge2_sub",
          "label": "Badge 2 Label",
          "default": "Fresh Ingredients"
        },
        {
          "type": "text",
          "id": "badge3_title",
          "label": "Badge 3 Title",
          "default": "Kalyan & Nearby"
        },
        {
          "type": "text",
          "id": "badge3_sub",
          "label": "Badge 3 Label",
          "default": "Delivery Range"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "kitchen_status" },
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "buttons" },
        { "type": "trust_badges" }
      ]
    }
  ]
}
{% endschema %}
