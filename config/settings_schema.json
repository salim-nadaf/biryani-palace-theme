[
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store Logo",
        "info": "Upload custom brand logo (used in header and footer)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Custom Logo Width (px)",
        "min": 80,
        "max": 350,
        "step": 5,
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Upload square icon image (PNG/ICO) for browser tab display"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page Background",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card / Surface Background",
        "default": "#161616"
      },
      {
        "type": "color",
        "id": "color_surface_elevated",
        "label": "Elevated Surface",
        "default": "#1E1E1E"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Saffron Gold Primary Accent",
        "default": "#E5A93C"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Gold Hover / Darker Gold",
        "default": "#C7881E"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Text Primary",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Text Secondary",
        "default": "#AAAAAA"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "rgba(229,169,60,0.16)"
      },
      {
        "type": "color",
        "id": "color_veg",
        "label": "Veg Indicator Color",
        "default": "#4CAF50"
      },
      {
        "type": "color",
        "id": "color_nonveg",
        "label": "Non-Veg Indicator Color",
        "default": "#E53935"
      }
    ]
  },
  {
    "name": "Brand Info & Contact",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand Name",
        "default": "Biryani Palace by Niamat"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand Tagline",
        "default": "Share the Joy"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Contact Phone Number",
        "default": "+91 98765 43210"
      },
      {
        "type": "text",
        "id": "delivery_areas",
        "label": "Delivery Areas (comma-separated)",
        "default": "Kalyan West, Kalyan East, Dombivli, Ambernath, Badlapur, Ulhasnagar, Thane, Bhiwandi"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Delivery Threshold (₹)",
        "default": 499
      }
    ]
  },
  {
    "name": "WhatsApp Support",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_whatsapp_order",
        "label": "Show Floating WhatsApp Button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Phone Number (with country code, e.g. 919876543210)",
        "default": "919876543210"
      },
      {
        "type": "text",
        "id": "whatsapp_order_msg",
        "label": "WhatsApp Pre-filled Message",
        "default": "Hi! I would like to place an order with Biryani Palace."
      }
    ]
  },
  {
    "name": "Kitchen Status & Timing",
    "settings": [
      {
        "type": "select",
        "id": "kitchen_status",
        "label": "Kitchen Operational Status",
        "options": [
          { "value": "open", "label": "Open — Accepting Orders" },
          { "value": "limited", "label": "Limited Stock / Busy" },
          { "value": "closed", "label": "Closed — Pre-orders Only" }
        ],
        "default": "open"
      },
      {
        "type": "text",
        "id": "kitchen_prep_time",
        "label": "Average Prep/Delivery Time (minutes)",
        "default": "30–60"
      }
    ]
  },
  {
    "name": "Header & Announcement",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Enable Sticky Header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_show_announcement",
        "label": "Show Announcement Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Bar Text",
        "default": "🔥 Free Delivery on Orders Above ₹499 | Authentic Dum Biryani Delivered Hot"
      }
    ]
  }
]
