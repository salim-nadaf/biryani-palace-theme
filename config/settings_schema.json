        "min": 80,
        "max": 300,
        "step": 10,
        "default": 140
      }
    ]
  },
  {
    "name": "WhatsApp",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_whatsapp_order",
        "label": "Show WhatsApp Button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Number (with country code)",
        "default": "919999999999"
      },
      {
        "type": "text",
        "id": "whatsapp_order_msg",
        "label": "WhatsApp Pre-filled Message",
        "default": "Hi! I'd like to place an order."
      }
    ]
  },
  {
    "name": "Kitchen",
    "settings": [
      {
        "type": "select",
        "id": "kitchen_status",
        "label": "Kitchen Status",
        "options": [
          { "value": "open", "label": "Open — Accepting Orders" },
          { "value": "limited", "label": "Limited Stock" },
          { "value": "closed", "label": "Closed — Pre-orders Only" }
        ],
        "default": "open"
      },
      {
        "type": "text",
        "id": "kitchen_prep_time",
        "label": "Prep Time Display",
        "default": "30–60"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Sticky Header",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Bar Text",
        "default": "Free delivery on orders above ₹499 · Delivering within 8 km"
      }
