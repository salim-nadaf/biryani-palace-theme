[
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store Logo",
        "info": "Upload custom brand logo (used in header and footer)"
      },
      {
        "type": "range",
        "id": "logo_max_height",
        "label": "Logo Max Height (px)",
        "min": 40,
        "max": 140,
        "step": 5,
        "default": 75,
        "info": "Prevents tall/square crest logos from expanding header"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Custom Logo Max Width (px)",
        "min": 60,
        "max": 300,
        "step": 5,
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image",
        "info": "Upload square icon image (PNG/ICO) for browser tab display"
      }
    ]
  },
  {
    "name": "Colors (60-30-10 Rule)",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page Background (60% Dominant Base)",
        "default": "#0B0B0C"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card / Surface Background (30% Secondary)",
        "default": "#16161A"
      },
      {
        "type": "color",
        "id": "color_surface_elevated",
        "label": "Elevated Surface",
        "default": "#1F1F24"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Saffron Gold Primary Accent (10% Focal CTA)",
        "default": "#F4B41A"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Gold Hover / Darker Gold",
        "default": "#D49010"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "label": "Text Primary",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Text Secondary",
        "default": "#AAAAA2"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "rgba(244,180,26,0.16)"
      },
      {
        "type": "color",
        "id": "color_veg",
        "label": "Veg Indicator Color",
        "default": "#2ECC71"
      },
      {
        "type": "color",
        "id": "color_nonveg",
        "label": "Non-Veg Indicator Color",
        "default": "#E74C3C"
      }
    ]
  },
  {
    "name": "Brand Info & Contact",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand Name",
        "default": "Biryani Palace by Niamat"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Brand Tagline",
        "default": "Share the Joy"
      },
      {
        "type": "text",
        "id": "phone_number",
        "label": "Contact Phone Number",
        "default": "+91 98765 43210"
      },
      {
        "type": "text",
        "id": "address_line",
        "label": "Restaurant Address",
        "default": "Kalyan, Maharashtra 421301"
      },
      {
        "type": "text",
        "id": "delivery_areas",
        "label": "Delivery Areas (comma-separated)",
        "default": "Kalyan West, Kalyan East, Dombivli, Ulhasnagar"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Delivery Threshold (₹)",
        "default": 799
      },
      {
        "type": "checkbox",
        "id": "enable_ajax_cart",
        "label": "Enable Ajax Cart Drawer",
        "default": true
      }
    ]
  },
  {
    "name": "WhatsApp Support",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_whatsapp_order",
        "label": "Show Floating WhatsApp Button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp Phone Number (with country code, e.g. 919876543210)",
        "default": "919876543210"
      },
      {
        "type": "text",
        "id": "whatsapp_order_msg",
        "label": "WhatsApp Pre-filled Message",
        "default": "Hi! I would like to place an order with Biryani Palace."
      }
    ]
  },
  {
    "name": "Kitchen Status & Timing",
    "settings": [
      {
        "type": "select",
        "id": "kitchen_status",
        "label": "Kitchen Operational Status",
        "options": [
          { "value": "open", "label": "Open — Accepting Orders" },
          { "value": "limited", "label": "Limited Stock / Busy" },
          { "value": "closed", "label": "Closed — Pre-orders Only" }
        ],
        "default": "open"
      },
      {
        "type": "text",
        "id": "kitchen_prep_time",
        "label": "Average Prep/Delivery Time (minutes)",
        "default": "30–60"
      }
    ]
  },
  {
    "name": "Header & Announcement",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Enable Sticky Header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_show_announcement",
        "label": "Show Announcement Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Bar Text",
        "default": "🔥 Free Delivery on Orders Above ₹799 | Delivering up to 8 KM (Kalyan, Dombivli, Ulhasnagar)"
      }
    ]
  }
]
